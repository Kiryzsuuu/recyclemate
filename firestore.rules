rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: apakah user sudah login?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: apakah ini adalah user yang bersangkutan?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ─── USERS ─────────────────────────────────────────────────────────────
    // User hanya bisa baca dan update profil sendiri
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false; // tidak boleh hapus akun via client
    }

    // ─── PRODUCTS ──────────────────────────────────────────────────────────
    // Semua orang bisa baca produk aktif
    // Hanya crafter pemilik yang bisa tulis
    match /products/{productId} {
      allow read: if true; // marketplace: bisa dibaca tanpa login
      allow create: if isAuthenticated()
        && request.resource.data.crafterId == request.auth.uid;
      allow update: if isAuthenticated()
        && (
          // pemilik produk bisa update
          resource.data.crafterId == request.auth.uid
          // atau update stock saat order (buyer beli)
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['stock'])
        );
      allow delete: if false; // soft delete via isActive:false
    }

    // ─── ORDERS ────────────────────────────────────────────────────────────
    // Buyer dan crafter bisa baca order masing-masing
    match /orders/{orderId} {
      allow read: if isAuthenticated()
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.crafterId == request.auth.uid
        );
      allow create: if isAuthenticated()
        && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAuthenticated()
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.crafterId == request.auth.uid
        );
      allow delete: if false;
    }

    // ─── DONATIONS ─────────────────────────────────────────────────────────
    // Hanya donor yang bisa baca dan kelola donasinya
    match /donations/{donationId} {
      allow read: if isAuthenticated()
        && resource.data.donorId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.donorId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.donorId == request.auth.uid
        && resource.data.status == 'pending'; // hanya bisa batalkan kalau pending
      allow delete: if false;
    }
  }
}
